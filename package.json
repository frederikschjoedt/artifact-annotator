{
  "name": "artifact-annotator",
  "version": "0.1.0",
  "description": "Annotate rendered Markdown and HTML artifacts, then return anchored feedback to a coding agent.",
  "type": "module",
  "bin": {
    "artifact-annotator": "bin/artifact-annotator.js"
  },
  "scripts": {
    "start": "node bin/artifact-annotator.js",
    "test": "node --test",
    "test:e2e": "node tests/e2e.mjs"
  },
  "keywords": [
    "annotation",
    "coding-agents",
    "markdown",
    "html"
  ],
  "author": "Frederik Schjoedt",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "marked": "^16.3.0",
    "open": "^10.2.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
